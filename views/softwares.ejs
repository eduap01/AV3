<% include partials/_header %>

<div class="container">
  <div class="row">
    <!--formulario-->
    <% if (user.rol === "admin" || user.rol === "profesor") { %>
    <div class="col-md-5">
      <div class="card">
        <div class="card-body">
          <form action="/softwares/add" method="post">

            <div class="form-group">
              <textarea class="form-control" name="description" cols="80" placeholder="Añade una descripción" required></textarea>
            </div>

            <div class="form-group">
              <input class="form-control" type="text" name="link" placeholder="Añade el enlace" required>
            </div>

            <div class="form-group">
                <label for="archive">Subir archivo</label>
                <input class="form-control" type="file" name="archive" placeholder="Añade el archivo">
            </div>
            <% if (typeof subject !== 'undefined') { %>
            <input type="hidden" name="subject" value="<%= subject._id %>">
            <% } %>

            <button class="btn btn-primary" type="submit">Añadir</button>
          </form>
        </div>
      </div>
    </div>
    <% } %>

    <!-- lista -->
    <div class="col-md-7">
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>N°</th>
            <th>Descripción</th>
            <th>Enlace</th>
            <th>Archivo</th>
            <th>Operaciones</th>
          </tr>
        </thead>
        <tbody>
         <% if (softwares.length > 0) { %>
           <% softwares.forEach((software, index) => { %>
             <tr>
               <td><%= index + 1 %></td>
               <td><strong><%= software.description %></strong></td>
               <td><%= software.link %></td>
               <td>
                         <% if (software.archive) { %>
                           <a href="/files/<%= software.archive %>" download="<%= software.archive %>">
                             <%= software.archive %>
                           </a>
                         <% } else { %>
                           <em>No hay archivo</em>
                         <% } %>
                       </td>
                 <% if (user.rol === "admin" || user.rol === "profesor") { %>
               <td>
                 <a href="/softwares/delete/<%= software._id %>" class="btn btn-danger">Eliminar</a>
                 <a href="/softwares/edit/<%= software._id %>" class="btn btn-info">Editar</a>
               </td>
            <% } %>
             </tr>
           <% }); %>
         <% } else { %>
           <tr>
             <td colspan="4" class="text-center">No hay softwares registrados para esta materia.</td>
           </tr>
         <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% include partials/_footer %>
