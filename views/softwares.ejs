<% include partials/_header %>

<div class="container">
  <div class="row">
    <!--FORM-->
    <% if (user.rol === "admin" || user.rol === "profesor") { %>
    <div class="col-md-5">
      <div class="card">
        <div class="card-body">
          <form action="/softwares/add" method="post">
            <div class="form-group">
              <input class="form-control" type="text" name="title" placeholder="Title">
            </div>
            <div class="form-group">
              <textarea class="form-control" name="description" cols="80" placeholder="Añade una descripción"></textarea>
            </div>
            <div class="form-group">
              <textarea class="form-control" name="link" cols="80" placeholder="Añade el link"></textarea>
            </div>
            <button class="btn btn-primary" type="submit">Add</button>
          </form>
        </div>
      </div>
    </div>
    <% } %>

    <!-- LIST -->
    <div class="col-md-7">
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>N°</th>
            <th>Title</th>
            <th>Description</th>
            <% if (user.rol === "admin" || user.rol === "profesor") { %>
              <th>Operations</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% for(var i=0; i < softwares.length; i++) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><strong><%= softwares[i].title %></strong></td>
              <td><%= softwares[i].description %></td>
              <% if (user.rol === "admin" || user.rol === "profesor") { %>
              <td>
                <a href="/softwares/delete/<%= softwares[i]._id %>" class="btn btn-danger">Delete</a>
                <a href="/softwares/edit/<%= softwares[i]._id %>" class="btn btn-info">Edit</a>
              </td>
              <% } %>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% include partials/_footer %>
