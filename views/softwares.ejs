<% include partials/_header %>

<div class="container mt-4 mb-4">
  <div class="row">
    <!-- FORMULARIO (Solo para admin o profesor) -->
    <% if (user.rol === "admin" || user.rol === "profesor") { %>
    <div class="col-12 col-md-5 mb-4">
      <div class="card">
        <div class="card-body">
          <form action="/softwares/add" method="post" enctype="multipart/form-data">
            <div class="form-group mb-3">
              <textarea class="form-control" name="description" cols="80" placeholder="Añade una descripción" required></textarea>
            </div>
            <div class="form-group mb-3">
              <input class="form-control" type="text" name="link" placeholder="Añade el link" required>
            </div>
            <div class="form-group mb-3">
                <label for="archive">Subir archivo</label>
                <input class="form-control" type="file" name="archive" placeholder="Añade el archivo">
                <small class="form-text text-muted">Tamaño máximo: 5MB</small>
            </div>
            <!-- Campo oculto para la asignatura -->
            <% if (typeof subject !== 'undefined') { %>
            <input type="hidden" name="subject" value="<%= subject._id %>">
            <% } %>

            <button class="btn btn-primary w-100" type="submit">Añadir</button>
          </form>
      <!-- Upload CSV
            <div class="card mt-3">
              <div class="card-body">
                <h5 class="card-title">Upload CSV</h5>
                <form action="/addSoftwaresCSV" method="post" enctype="multipart/form-data">
                  <div class="form-group">
                    <label for="csvFile">Select CSV File</label>
                    <input id="csvFile" class="form-control-file" type="file" name="archive" accept=".csv" required>
                  </div>
                  <button class="btn btn-primary btn-block mt-3" type="submit">Upload CSV</button>
                </form>
              </div>
            </div>
          </div>-->

          <form action="/addSoftwaresCSV" method="post" enctype="multipart/form-data">
            <div class="form-group">
              <label for="csvFile">Select CSV File</label>
              <input id="csvFile" class="form-control-file" type="file" name="archive" accept=".csv" required>
            </div>

            <!-- Campo oculto para enviar subjectId desde la URL -->
            <input type="hidden" id="subject" name="subject" value="">

            <button class="btn btn-primary btn-block mt-3" type="submit">Upload CSV</button>
          </form>

          <script>
            // Capturar la ID de la asignatura desde la URL y asignarla al input oculto
            document.addEventListener("DOMContentLoaded", function () {
              const urlParts = window.location.pathname.split("/");
              const subjectId = urlParts[urlParts.indexOf("subject") + 1]; // Obtener el ID después de 'subject'
              document.getElementById("subject").value = subjectId;
            });
          </script>


        </div>
      </div>
    </div>
    <% } %>
    <!-- LISTA DE SOFTWARES -->
    <div class="col-12 col-md-7">
      <h3 class="text-center">Lista de Softwares</h3>
      <div class="table-responsive">
        <table class="table table-bordered table-hover">
          <thead>
            <tr>
              <th>N°</th>
              <th>Descripción</th>
              <th>Enlace</th>
              <th>Archivo</th>
              <th>Operaciones</th>
            </tr>
          </thead>
          <tbody>
            <% if (softwares.length > 0) { %>
              <% softwares.forEach((software, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td><strong><%= software.description %></strong></td>
                  <td><%= software.link %></td>
                  <td>
                      <% if (software.archive) { %>
                            <a href="/files/<%= software.archive %>" download="<%= software.archive %>" title="<%= software.archive %>">
                                <%= software.archive.length > 20 ? software.archive.substring(0, 20) + '...' : software.archive %>
                            </a>
                        <% } else { %>
                        <em>No hay archivo</em>
                        <% } %>
                  </td>
                  <td>
                    <a href="/softwares/delete/<%= software._id %>" class="btn btn-danger btn-sm">Eliminar</a>
                    <a href="/softwares/edit/<%= software._id %>" class="btn btn-info btn-sm">Editar</a>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center">No hay softwares registrados para esta materia.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<% include partials/_footer %>