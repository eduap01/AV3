<% include partials/_header %>

<div class="container">
  <div class="row">
    <!-- FORM -->
    <div class="col-md-5 offset-md-3">
      <div class="card">
        <div class="card-body">
          <form action="/studies/edit/<%= study._id %>" method="post">

            <!-- Nombre -->
            <div class="form-group">
              <label for="name">Nombre</label>
              <input
                id="name"
                class="form-control"
                type="text"
                name="name"
                placeholder="Nombre"
                value="<%= study.name %>"
                required>
            </div>

            <!-- Tipo -->
            <div class="form-group">
              <label for="type">Tipo</label>
              <input
                id="type"
                class="form-control"
                type="text"
                name="type"
                placeholder="Tipo"
                value="<%= study.type %>"
                required>
            </div>

            <button class="btn btn-primary" type="submit">
              Actualizar
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<% include partials/_footer %>
