<% include partials/_header %>

<div class="container mt-4">
  <div class="row">
    <!-- FORMULARIO (Solo para admin) -->
    <% if (user.rol === "admin") { %>
    <div class="col-12 col-md-5 mb-4">
      <div class="card">
        <div class="card-body">
          <form action="/studies/add" method="post">
            <div class="form-group mb-3">
              <input class="form-control" type="text" name="name" placeholder="Nombre" required>
            </div>
            <div class="form-group mb-3">
              <input class="form-control" type="text" name="type" placeholder="Tipo" required>
            </div>
            <button class="btn btn-primary w-100" type="submit">Agregar</button>
          </form>
        </div>
      </div>
    </div>
    <% } %>

    <!-- LISTA DE ESTUDIOS -->
    <div class="col-12 col-md-7">
      <h3 class="text-center">Lista de Estudios</h3>
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>N°</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <% if (user.rol === "admin") { %>
              <th>Operaciones</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% studies.forEach((study, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td><strong><%= study.name %></strong></td>
              <td><%= study.type %></td>
              <% if (user.rol === "admin") { %>
              <td>
                <a href="/studies/delete/<%= study._id %>" class="btn btn-danger btn-sm">Eliminar</a>
                <a href="/studies/edit/<%= study._id %>" class="btn btn-info btn-sm">Editar</a>
              </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% include partials/_footer %>
