<% include partials/_header %>
<div class="container">
  <div class="row">
    <!-- FORM -->
    <div class="col-md-5 offset-md-3">
      <div class="card">
        <div class="card-body">
          <form action="/softwares/edit/<%= software._id %>" method="post">
            <div class="form-group">
              <input
                class="form-control"
                type="text"
                name="description"
                placeholder="Descripcion"
                value="<%= software.description %>"
                required>
            </div>
            <div class="form-group">
              <input
                class="form-control"
                type="text"
                name="link"
                placeholder="Link"
                value="<%= software.link %>"
                required>
            </div>
            <button class="btn btn-primary" type="submit">
              Actualizar
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<% include partials/_footer %>
