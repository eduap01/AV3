<% include partials/_header %>

<div class="container">
  <div class="row">
    <!-- FORM -->
    <div class="col-md-5 offset-md-3">
      <div class="card">
        <div class="card-body">
          <form action="/users/edit/<%= user._id %>" method="post">

            <!-- Nombre -->
            <div class="form-group">
              <label for="name">Nombre</label>
              <input
                id="name"
                class="form-control"
                type="text"
                name="name"
                placeholder="Nombre"
                value="<%= user.name %>"
                required>
            </div>

            <!-- Apellidos -->
            <div class="form-group">
              <label for="surname">Apellidos</label>
              <input
                id="surname"
                class="form-control"
                type="text"
                name="surname"
                placeholder="Apellidos"
                value="<%= user.surname %>"
                required>
            </div>

            <!-- Contraseña -->
            <div class="form-group">
              <label for="password">Contraseña</label>
              <input
                id="password"
                class="form-control"
                type="password"
                name="password"
                placeholder="Contraseña"
                required>
            </div>

            <!-- E-mail -->
            <div class="form-group">
              <label for="email">E-mail</label>
              <input
                id="email"
                class="form-control"
                type="email"
                name="email"
                placeholder="E-mail"
                value="<%= user.email %>"
                required>
            </div>

            <!-- Rol -->
            <div class="form-group">
              <label for="rol">Rol</label>
              <input
                id="rol"
                class="form-control"
                type="text"
                name="rol"
                placeholder="Rol"
                value="<%= user.rol %>"
                required>
            </div>

            <button class="btn btn-primary" type="submit">
              Actualizar
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<% include partials/_footer %>
