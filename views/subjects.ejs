<% include partials/_header %>

<div class="container">
  <div class="row">
    <!-- FORMULARIO (Izquierda) -->
    <div class="col-md-5">
      <% if (user.rol === "admin") { %>
      <div class="card">
        <div class="card-body">
          <h3 class="text-center">Añadir Asignatura</h3>
          <form action="/subjects/add" method="post">
            <!-- Nombre -->
            <div class="form-group">
              <label>Nombre:</label>
              <input class="form-control" type="text" name="name" placeholder="Nombre de la asignatura" required>
            </div>

            <!-- Curso -->

       <select class="form-select" name="study" id="study" aria-label="Default select example">
           <% for (var i=0; i < studies.length; i++){%>
         <option value="<%=studies[i]._id%>"><%=studies[i].name%></option>
    <%}%>
       </select>
        <div class="form-group">
                      <label>Curso:</label>
                      <input class="form-control" type="text" name="grade" placeholder="Ejemplo: 10° Grado" required>
                    </div>

            <!-- Descripción -->
            <div class="form-group">
              <label>Descripción:</label>
              <textarea class="form-control" name="description" placeholder="Añade una descripción" rows="3"></textarea>
            </div>

            <!-- Profesores -->
            <div class="form-group">
              <label>Profesores:</label>
              <% teachers.forEach(teacher => { %>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="teachers" value="<%= teacher._id %>">
                  <label class="form-check-label"><%= teacher.name %></label>
                </div>
              <% }); %>
            </div>

            <!-- Alumnos -->
            <div class="form-group">
              <label>Alumnos:</label>
              <% students.forEach(student => { %>
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="students" value="<%= student._id %>">
                  <label class="form-check-label"><%= student.name %></label>
                </div>
              <% }); %>
            </div>

            <!-- Botón de enviar -->
            <button class="btn btn-primary btn-block mt-3" type="submit">Añadir Asignatura</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>

    <!-- LISTA DE ASIGNATURAS (Derecha) -->
    <div class="col-md-7">
      <h3 class="text-center">Lista de Asignaturas</h3>
      <table class="table table-bordered table-hover">
        <thead>
          <tr>
            <th>N°</th>
            <th>Nombre</th>
            <th>Estudio</th>
            <th>Curso</th>
            <th>Profesores</th>
            <th>Alumnos</th>
            <% if (user.rol === "admin" || user.rol === "profesor") { %>
              <th>Operaciones</th>
            <% } %>
          </tr>
        </thead>
        <tbody>
          <% subjects.forEach((subject, index) => { %>
            <tr>
              <td><%= index + 1 %></td>
              <td>
                   <a href="/softwares/subject/<%= subject._id %>"><strong><%= subject.name %></strong></a>
              </td>
              <td><%= subject.study.name %></td>
              <td><%= subject.grade %></td>
              <td>
                <% subject.teachers.forEach(teacher => { %>
                  <span><%= teacher.name + " " + teacher.surname %></span><br>
                <% }); %>
              </td>
              <td>
                <% subject.students.forEach(student => { %>
                  <span><%= student.name + " " + student.surname %></span><br>
                <% }); %>
              </td>
              <% if (user.rol === "admin" || user.rol === "profesor") { %>
              <td>
                <% if (user.rol === "admin") { %>
                  <a href="/subjects/edit/<%= subject._id %>" class="btn btn-info btn-sm">Editar</a>
                  <a href="/subjects/delete/<%= subject._id %>" class="btn btn-danger btn-sm">Eliminar</a>
                <% } %>
                <% if (user.rol === "profesor") { %>
                  <a href="/subjects/edit/<%= subject._id %>" class="btn btn-info btn-sm">Editar</a>
                <% } %>
              </td>
              <% } %>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% include partials/_footer %>
